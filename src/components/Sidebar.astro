---
const menu = [
    { label: "Dashboard", href: "#dashboard" },
    { label: "Discover", href: "#discover" },
    { label: "Sessions", href: "#sessions" },
    { label: "Settings", href: "#settings" }
];
---

<aside class="w-64 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl p-6 sticky top-10 self-start shadow-xl">
    <h2 class="text-xl font-bold text-white mb-8 tracking-wide">
        Track Time
    </h2>

    <nav class="space-y-3 text-sm">
        {menu.map(item => (
            <a
                href={item.href}
                class="block px-3 py-2 rounded-xl text-gray-300 hover:text-white hover:bg-white/10 transition active:scale-95"
            >
                {item.label}
            </a>
        ))}
    </nav>
</aside>