---
// src/layouts/MainLayout.astro
import "../styles/global.css";
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Track Time - One app for all motorsport race schedules: F1, MotoGP, IndyCar, WEC, NASCAR and more. All time zones. No clutter." />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      // Dark mode detection
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark')
      }
    </script>
  </head>
  <body class="bg-neutral-50 dark:bg-black text-gray-900 dark:text-gray-100 min-h-screen">
    <slot />
  </body>
</html>