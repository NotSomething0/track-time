---
import * as db from '../database/profile/index';
import getEventsBySeriesId from '../database/event/getEventsBySeriesId'
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import NextEventCard from '../components/NextEventCard.astro';
import UpcomingEvents from '../components/UpcomingEvents.svelte';
import DiscoverSeries from '../components/DiscoverSeries.svelte';
import DashboardViewController from "../components/DashboardViewController.svelte";
import UserProfileButton from '../components/home/UserProfileButton.svelte'

const series = [
  {
    id: 1,
    name: "Formula 1",
    description: "The pinnacle of single-seater motorsport.",
    followers: 1250000,
    following: false
  },
  {
    id: 2,
    name: "WEC Championship",
    description: "World Endurance Championship featuring hypercars.",
    followers: 340000,
    following: false
  },
  {
    id: 3,
    name: "IndyCar Series",
    description: "High-speed open wheel racing across North America.",
    followers: 290000,
    following: false
  },
  {
    id: 4,
    name: "IMSA SportsCar",
    description: "Multi-class endurance racing in the United States.",
    followers: 180000,
    following: false
  }
];

const container = "mx-auto max-w-6xl px-6 md:px-10";

const a = await Astro.session?.get('profile');

const profile = await db.getProfileById(Astro.session, a?.user_id) //await Astro.session?.get('profile');
const events = await getEventsBySeriesId(Astro.session, profile.followed_series)
---

<Layout title="Track Time | Pro Dashboard">
  <header class=" max-w-6xl mx-auto px-6 md:px-10 mt-10 relative">
    <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-2xl shadow-2xl">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 px-6 py-6">

        <div class="space-y-1">
          <h1 class="text-2xl font-bold tracking-tight text-white">
            Track Time
          </h1>
        </div>

        <UserProfileButton 
          client:idle
          name="Alex Chen"
          email="alex@example.com"
        />
      </div>
    </div>
  </header>

  <main class={`${container} flex gap-6 mt-8`}>
    <Sidebar />

    <div class="flex-1 space-y-8 min-h-screen">
      <DashboardViewController client:load>
        <div slot="dashboard">
          <NextEventCard />
          <UpcomingEvents events={events} client:load />
        </div>

        <div slot="discover">
          <DiscoverSeries series={series} client:load />
        </div>
      </DashboardViewController>
    </div>
  </main>

  <footer class={`${container} py-10 border-t border-white/10 mt-16 text-sm text-gray-400`}>
    Track Time Dashboard © 2025
  </footer>
</Layout>
