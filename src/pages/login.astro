---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/LoginForm.svelte';

const profile = await Astro.session?.get('profile');

if (profile) {
  return Astro.redirect('/dashboard', 302);
}

const flash: string|null = await Astro.session?.get('flash') || null;
---

<Layout title="Login • Track Time">
  <div class="min-h-screen flex items-center justify-center px-6 relative overflow-hidden">
    <div class="w-full max-w-md">
      <div class="text-center mb-12 text-5xl md:text-6xl font-black tracking-tighter">
        <span class="text-[#FF2800]">TRACK</span><span class="text-[#FF8000]">TIME</span>
      </div>

      {flash && (
        <div class="mb-8 p-5 rounded-2xl bg-green-900/40 border border-green-500/50 text-green-200 text-center font-medium animate-fade-in">
          <p>{flash}</p>
        </div>
      )}

      <LoginForm client:load/>

      <div class="text-center mt-6 text-gray-500 text-sm">
        <a href="/forgot" class="text-[#FF8000] hover:text-[#ffb84d] text-sm font-medium">Forgot password?</a> <br>
        <span>Don't have an account?</span> 
        <a href="/signup" class="text-[#00A0DE] hover:text-[#00c0ff] font-bold">Sign up</a>
      </div>
    </div>
  </div>
</Layout>